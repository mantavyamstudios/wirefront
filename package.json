{
  "name": "wirefront",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "npm@10.9.7",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:www": "turbo run dev --filter=@wirefront/www",
    "predev": "npm run registry",
    "build": "turbo run build",
    "prebuild": "npm run registry",
    "lint": "biome lint",
    "typecheck": "turbo run typecheck && tsc -p scripts",
    "registry": "tsx scripts/build-registry.ts",
    "snapshot": "tsx scripts/snapshot.ts",
    "audit:responsive": "tsx scripts/responsive-audit.ts",
    "spdx": "tsx scripts/spdx.ts",
    "spdx:check": "tsx scripts/spdx.ts --check",
    "test": "npm run test -w @wirefront/www",
    "prepare": "git config core.hooksPath .githooks || true",
    "lint:gate": "tsx scripts/lint-gate.ts",
    "lint:baseline": "tsx scripts/lint-gate.ts --update",
    "test:install": "tsx scripts/install-test.ts",
    "test:browser": "tsx scripts/browser-test.ts",
    "test:visual": "tsx scripts/visual-test.ts",
    "test:phase": "tsx scripts/phase-check.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "^24.12.2",
    "@types/pngjs": "6.0.5",
    "axe-core": "4.14.0",
    "pixelmatch": "8.0.0",
    "playwright": "^1.49.0",
    "pngjs": "7.0.0",
    "tsx": "^4.19.2",
    "turbo": "^2.9.6",
    "typescript": "~6.0.2",
    "zod": "^4.3.6"
  }
}
