/**
 * Builds `__registry__/` for the docs toolkit (ComponentPreview,
 * ComponentInstallation, ComponentFileStructure, ComponentCredits), in the
 * shape Sora UI's own registry build writes, from Wirefront's shadcn registry
 * (public/r/<kind>-<screen>.json, written by `bun run registry` at the repo
 * root) and the screens manifest.
 *
 *   bun scripts/docs-registry.mts   # runs before dev, build and check-types
 *
 * Each entry's `component` is the screen running in the runtime iframe.
 */
import {
  existsSync,
  mkdirSync,
  readFileSync,
  rmSync,
  writeFileSync,
} from "node:fs";
import path from "node:path";

import manifest from "../lib/screens/screens.manifest.json" with { type: "json" };
import { SITE_URL } from "../lib/site.ts";

const WWW = path.resolve(import.meta.dirname, "..");
const REGISTRY = path.join(WWW, "public/r");
const SHOWCASE = path.resolve(WWW, "../runtime/src/pages/showcase");
const OUT = path.join(WWW, "__registry__");

interface RegistryFile {
  content: string;
  path: string;
  target?: string;
  type: string;
}
interface RegistryItem {
  dependencies?: string[];
  description?: string;
  devDependencies?: string[];
  files: RegistryFile[];
  name: string;
  registryDependencies?: string[];
  type: string;
}

const DEVL_DEV = {
  type: "adapted",
  label: "devl.dev",
  url: "https://github.com/sean-brydon/devl.dev",
};

/** `@components/x` → `components/x`, the path the CLI writes in the project. */
const projectPath = (target?: string) => target?.replace(/^@/u, "");

if (!existsSync(path.join(REGISTRY, "registry.json"))) {
  console.error(
    "docs-registry: public/r is missing. Run `bun run registry` at the repo root first."
  );
  process.exit(1);
}

rmSync(OUT, { recursive: true, force: true });
mkdirSync(path.join(OUT, "sources"), { recursive: true });

const toIdentifier = (name: string) =>
  name
    .replaceAll(/(?:^|-)(?<char>[a-z0-9])/gu, (_, c: string) => c.toUpperCase())
    .replace(/^(?<digit>\d)/u, "Screen$<digit>");

const entries: string[] = [];
const loaders: string[] = [];
for (const group of manifest.groups) {
  for (const kind of group.kinds) {
    for (const screen of kind.screens) {
      const item = JSON.parse(
        readFileSync(path.join(REGISTRY, `${screen.registry}.json`), "utf-8")
      ) as RegistryItem;
      const view =
        screen.files.find((f) => f.endsWith("view.tsx")) ?? screen.files[0];
      const ported = view
        ? readFileSync(path.join(SHOWCASE, view), "utf-8").includes(
            "Ported from devl.dev"
          )
        : false;
      const files = item.files.map((f) => ({
        path: f.path,
        type: f.type,
        target: projectPath(f.target),
      }));
      const entry = {
        name: item.name,
        description: item.description ?? "",
        type: item.type,
        dependencies: item.dependencies,
        devDependencies: item.devDependencies,
        registryDependencies: item.registryDependencies,
        files,
        fileGroups: null,
        hasSource: true,
        keywords: [],
        releaseDate: null,
        inspiration: ported ? DEVL_DEV : null,
        command: `${SITE_URL}/r/${item.name}.json`,
      };
      const json = JSON.stringify(entry, null, 2).replace(/\n\}$/u, "");
      entries.push(
        `  ${JSON.stringify(item.name)}: ${json},\n    component: function ${toIdentifier(item.name)}() {\n      return <ScreenRuntimePreview kind=${JSON.stringify(kind.slug)} screen=${JSON.stringify(screen.slug)} title=${JSON.stringify(screen.title)} />;\n    },\n  },`
      );
      writeFileSync(
        path.join(OUT, "sources", `${item.name}.json`),
        `${JSON.stringify({ name: item.name, code: item.files[0]?.content ?? "", files: item.files.map((f) => ({ ...f, target: projectPath(f.target) })) })}\n`
      );
      loaders.push(
        `  ${JSON.stringify(item.name)}: () => import("./sources/${item.name}.json"),`
      );
    }
  }
}

writeFileSync(
  path.join(OUT, "index.tsx"),
  `// @ts-nocheck
// This file is generated by scripts/docs-registry.mts. Do not edit it.
import { ScreenRuntimePreview } from "@/components/screens/screen-runtime-preview";

export const index: Record<string, any> = {
${entries.join("\n")}
};

export { loadComponentFiles, loadComponentHtml, loadComponentSource } from "./sources";
`
);

writeFileSync(
  path.join(OUT, "sources.ts"),
  `// @ts-nocheck
// This file is generated by scripts/docs-registry.mts. Do not edit it.
export const sourceLoaders: Record<string, () => Promise<any>> = {
${loaders.join("\n")}
};

const cache = new Map<string, Promise<any | null>>();

function load(name: string): Promise<any | null> {
  const loader = sourceLoaders[name];
  if (!loader) {
    return Promise.resolve(null);
  }
  if (!cache.has(name)) {
    cache.set(
      name,
      loader().then((mod) => mod.default ?? mod),
    );
  }
  return cache.get(name) as Promise<any | null>;
}

export async function loadComponentSource(name: string): Promise<string | null> {
  const data = await load(name);
  return data?.code || data?.files?.[0]?.content || null;
}

/** Not pre-highlighted: the code blocks highlight on the client. */
export async function loadComponentHtml(name: string): Promise<string | null> {
  const data = await load(name);
  return data?.highlightedHtml || data?.files?.[0]?.highlightedHtml || null;
}

export async function loadComponentFiles(name: string): Promise<any[] | null> {
  const data = await load(name);
  return data?.files ?? null;
}
`
);

console.log(`docs-registry: wrote __registry__ for ${entries.length} screens.`);
