/**
 * Flows manifest: the bridge between the Flutter catalogue
 * (`apps/runtime/lib/core/data/flows_data.dart`) and this site.
 *
 *   bun scripts/flows-manifest.mts          # write manifest + meta.json, add missing MDX stubs
 *                                           # (runs automatically before `dev` and `build`)
 *   bun scripts/flows-manifest.mts --check  # exit 1 if anything drifted from the Dart catalogue
 *
 * Writes:
 *   lib/flows/flows.manifest.json  — categories, subflows, source dir, packages, device APIs
 *   content/flows/meta.json        — sidebar order with one separator per category
 *   content/flows/<cat>/<sub>.mdx  — editorial page per subflow (created once, never overwritten)
 *   public/_redirects              — the block between the "flows:categories" markers:
 *                                    /flows/<cat> and /flows/<cat>/ → /flows#<cat>
 */
import {
  existsSync,
  mkdirSync,
  readdirSync,
  readFileSync,
  statSync,
  writeFileSync,
} from "node:fs";
import path from "node:path";
import { isDeepStrictEqual } from "node:util";

const WWW = path.resolve(import.meta.dirname, "..");
const RUNTIME = path.resolve(WWW, "../runtime");
const LIB = path.join(RUNTIME, "lib");
const FLOWS_DATA = path.join(LIB, "core/data/flows_data.dart");
const MANIFEST = path.join(WWW, "lib/flows/flows.manifest.json");
const CONTENT = path.join(WWW, "content/flows");
const META = path.join(CONTENT, "meta.json");
const REDIRECTS = path.join(WWW, "public/_redirects");
const REDIRECTS_BEGIN =
  "# BEGIN flows:categories (generated by scripts/flows-manifest.mts; do not edit)";
const REDIRECTS_END = "# END flows:categories";
const PACKAGE = "enterprise_ui_playground";

/** Package imports that need a device capability (shown as "limited in browser"). */
const DEVICE_APIS: Record<string, string> = {
  camera: "camera",
  mobile_scanner: "camera",
  image_picker: "photos",
  record: "microphone",
  speech_to_text: "microphone",
  google_maps_flutter: "maps",
  location: "location",
};
const IGNORED_PACKAGES = new Set([
  "flutter",
  "flutter_test",
  "flutter_web_plugins",
  PACKAGE,
]);

interface ManifestSubflow {
  deviceApis: string[];
  /** Source folder relative to `apps/runtime/lib/flows`. */
  dir: string;
  /** Entry widget class built by the runtime. */
  entry: string;
  /** Entry file relative to `apps/runtime/lib`. */
  entryFile: string;
  files: number;
  /** Files outside `dir` the subflow imports, relative to `apps/runtime/lib`. */
  localDeps: string[];
  packages: string[];
  slug: string;
  status: "built" | "comingSoon";
  title: string;
}

interface ManifestCategory {
  blurb: string;
  slug: string;
  subflows: ManifestSubflow[];
  title: string;
}

interface Manifest {
  categories: ManifestCategory[];
  source: string;
  totals: { categories: number; subflows: number };
}

const fail = (message: string): never => {
  throw new Error(`flows-manifest: ${message}`);
};

/** First `key: '<value>'` (single- or double-quoted Dart string) in `text`. */
function stringField(text: string, key: string): string | undefined {
  const match = new RegExp(
    `\\b${key}:\\s*(?:'((?:[^'\\\\]|\\\\.)*)'|"((?:[^"\\\\]|\\\\.)*)")`
  ).exec(text);
  if (!match) {
    return undefined;
  }
  return (match[1] ?? match[2]).replaceAll(/\\(.)/g, "$1");
}

/** Splits `text` into the bodies of each `<name>(...)` call, honouring nested parens. */
function callBodies(text: string, name: string): string[] {
  const bodies: string[] = [];
  const re = new RegExp(`\\b${name}\\(`, "g");
  let match: RegExpExecArray | null;
  while ((match = re.exec(text))) {
    let depth = 1;
    let i = match.index + match[0].length;
    const start = i;
    for (; i < text.length && depth > 0; i++) {
      if (text[i] === "(") {
        depth++;
      } else if (text[i] === ")") {
        depth--;
      }
    }
    bodies.push(text.slice(start, i - 1));
    re.lastIndex = i;
  }
  return bodies;
}

function dartFiles(dir: string): string[] {
  return readdirSync(dir).flatMap((name) => {
    const full = path.join(dir, name);
    if (statSync(full).isDirectory()) {
      return dartFiles(full);
    }
    return name.endsWith(".dart") ? [full] : [];
  });
}

/** Resolves a Dart import URI from `fromFile` to an absolute path inside `lib/`, or null for other packages. */
function resolveImport(uri: string, fromFile: string): string | null {
  if (uri.startsWith(`package:${PACKAGE}/`)) {
    return path.join(LIB, uri.slice(`package:${PACKAGE}/`.length));
  }
  if (uri.startsWith("package:") || uri.startsWith("dart:")) {
    return null;
  }
  return path.resolve(path.dirname(fromFile), uri);
}

const IMPORT_RE = /^\s*(?:import|export)\s+['"]([^'"]+)['"]/gm;

function scanDir(absDir: string) {
  const files = dartFiles(absDir);
  const packages = new Set<string>();
  const localDeps = new Set<string>();
  for (const file of files) {
    for (const [, uri] of readFileSync(file, "utf-8").matchAll(IMPORT_RE)) {
      if (uri.startsWith("package:")) {
        const pkg = uri.slice("package:".length).split("/")[0];
        if (!IGNORED_PACKAGES.has(pkg)) {
          packages.add(pkg);
        }
      }
      const target = resolveImport(uri, file);
      if (target && !target.startsWith(`${absDir}/`)) {
        localDeps.add(path.relative(LIB, target));
      }
    }
  }
  const sortedPackages = [...packages].toSorted();
  return {
    files: files.length,
    packages: sortedPackages,
    localDeps: [...localDeps].toSorted(),
    deviceApis: [
      ...new Set(sortedPackages.flatMap((p) => DEVICE_APIS[p] ?? [])),
    ].toSorted(),
  };
}

export function buildManifest(): Manifest {
  const source = readFileSync(FLOWS_DATA, "utf-8");

  // Entry class -> file, from the catalogue's own imports.
  const importedFiles = [...source.matchAll(IMPORT_RE)].flatMap(([, uri]) => {
    const file = resolveImport(uri, FLOWS_DATA);
    return file?.includes("/flows/") ? [file] : [];
  });
  const classFile = (cls: string) => {
    const hits = importedFiles.filter((f) =>
      new RegExp(`\\bclass\\s+${cls}\\b`).test(readFileSync(f, "utf-8"))
    );
    return hits.length === 1
      ? hits[0]
      : fail(`entry class ${cls} found in ${hits.length} imported files`);
  };

  // Builder tear-off -> entry class: `Widget _x(BuildContext context) => const Foo(...)`.
  const builderClass = new Map(
    [
      ...source.matchAll(
        /Widget\s+(_\w+)\(BuildContext \w+\)\s*=>\s*(?:const\s+)?(\w+)\(/g
      ),
    ].map(([, fn, cls]) => [fn, cls])
  );

  const listStart = source.indexOf("kAllFlows");
  if (listStart === -1) {
    fail("kAllFlows not found");
  }

  const categories = callBodies(source.slice(listStart), "AppFlow").map(
    (flowBody): ManifestCategory => {
      const subflowsAt = flowBody.indexOf("subFlows:");
      const head = flowBody.slice(0, subflowsAt);
      const slug = stringField(head, "slug") ?? fail("AppFlow without slug");
      return {
        slug,
        title: stringField(head, "title") ?? fail(`${slug}: no title`),
        blurb: stringField(head, "blurb") ?? "",
        subflows: callBodies(flowBody.slice(subflowsAt), "SubFlow").map(
          (body): ManifestSubflow => {
            const subSlug =
              stringField(body, "slug") ??
              fail(`${slug}: SubFlow without slug`);
            const builder =
              /screenBuilder:\s*(_\w+)/.exec(body)?.[1] ??
              fail(`${slug}/${subSlug}: no screenBuilder`);
            const entry =
              builderClass.get(builder) ??
              fail(`${slug}/${subSlug}: builder ${builder} not found`);
            const entryPath = classFile(entry);
            const [group, folder] = path
              .relative(path.join(LIB, "flows"), entryPath)
              .split("/");
            const dir = `${group}/${folder}`;
            return {
              slug: subSlug,
              title:
                stringField(body, "title") ??
                fail(`${slug}/${subSlug}: no title`),
              status: /status:\s*SubFlowStatus\.built/.test(body)
                ? "built"
                : "comingSoon",
              entry,
              entryFile: path.relative(LIB, entryPath),
              dir,
              ...scanDir(path.join(LIB, "flows", dir)),
            };
          }
        ),
      };
    }
  );

  return {
    source: "apps/runtime/lib/core/data/flows_data.dart",
    totals: {
      categories: categories.length,
      subflows: categories.reduce((n, c) => n + c.subflows.length, 0),
    },
    categories,
  };
}

function buildMeta(manifest: Manifest) {
  return {
    title: "Flows",
    description: "Live Flutter user flows",
    icon: "Workflow",
    root: true,
    pages: manifest.categories.flatMap((c) => [
      `---${c.title}---`,
      ...c.subflows.map((s) => `${c.slug}/${s.slug}`),
    ]),
  };
}

function mdxStub(category: ManifestCategory, sub: ManifestSubflow): string {
  return `---
title: ${JSON.stringify(sub.title)}
description: ${JSON.stringify(`${sub.title} flow in ${category.title}.`)}
---

## Overview

${sub.title} flow in ${category.title}.
`;
}

type FlowsMeta = ReturnType<typeof buildMeta>;

const json = (value: Manifest | FlowsMeta) =>
  `${JSON.stringify(value, null, 2)}\n`;

/** True when `file` holds JSON equal to `value` (formatting-insensitive, so ultracite may reformat it). */
const jsonMatches = (file: string, value: Manifest | FlowsMeta) =>
  existsSync(file) &&
  isDeepStrictEqual(JSON.parse(readFileSync(file, "utf-8")), value);

function existingMdx(): string[] {
  if (!existsSync(CONTENT)) {
    return [];
  }
  return readdirSync(CONTENT)
    .filter((d) => statSync(path.join(CONTENT, d)).isDirectory())
    .flatMap((d) =>
      readdirSync(path.join(CONTENT, d))
        .filter((f) => f.endsWith(".mdx"))
        .map((f) => `${d}/${f.slice(0, -4)}`)
    )
    .toSorted();
}

// Format generated files with the repo formatter, so they pass `lint`.
// A failure is reported, not hidden: the files are still valid, only unformatted.
function formatWritten(files: string[]) {
  if (files.length === 0) {
    return;
  }
  const result = Bun.spawnSync(["bunx", "ultracite", "fix", ...files], {
    cwd: path.resolve(WWW, "../.."),
    stderr: "pipe",
    stdout: "pipe",
  });
  if (result.exitCode !== 0) {
    console.warn(
      `Warning: could not format generated files (exit ${result.exitCode}); run 'bun run lint:fix'.\n${result.stderr.toString()}${result.stdout.toString()}`
    );
  }
}

// A category is a section of the /flows gallery, not a page: its URL (with or
// without a trailing slash, since Pages matches exactly) goes to that section.
function categoryRedirects(manifest: Manifest): string {
  const rules = manifest.categories.flatMap((c) => [
    `/flows/${c.slug} /flows#${c.slug} 301`,
    `/flows/${c.slug}/ /flows#${c.slug} 301`,
  ]);
  return [REDIRECTS_BEGIN, ...rules, REDIRECTS_END].join("\n");
}

/** `_redirects` with the generated block replaced; throws if the markers are missing. */
function redirectsWithCategories(manifest: Manifest): {
  current: string;
  next: string;
} {
  const current = readFileSync(REDIRECTS, "utf-8");
  const start = current.indexOf(REDIRECTS_BEGIN);
  const end = current.indexOf(REDIRECTS_END);
  if (start === -1 || end === -1 || end < start) {
    throw new Error(
      `public/_redirects must contain the lines "${REDIRECTS_BEGIN}" and "${REDIRECTS_END}"`
    );
  }
  const next =
    current.slice(0, start) +
    categoryRedirects(manifest) +
    current.slice(end + REDIRECTS_END.length);
  return { current, next };
}

function main() {
  const check = process.argv.includes("--check");
  const manifest = buildManifest();
  const meta = buildMeta(manifest);
  const expectedPages = manifest.categories
    .flatMap((c) => c.subflows.map((s) => `${c.slug}/${s.slug}`))
    .toSorted();

  if (check) {
    const problems: string[] = [];
    if (!jsonMatches(MANIFEST, manifest)) {
      problems.push(
        "lib/flows/flows.manifest.json is out of date with flows_data.dart"
      );
    }
    if (!jsonMatches(META, meta)) {
      problems.push(
        "content/flows/meta.json is out of date with flows_data.dart"
      );
    }
    const redirects = redirectsWithCategories(manifest);
    if (redirects.current !== redirects.next) {
      problems.push(
        "public/_redirects category rules are out of date with flows_data.dart"
      );
    }
    const pages = existingMdx();
    for (const p of expectedPages.filter((p) => !pages.includes(p))) {
      problems.push(`missing content/flows/${p}.mdx`);
    }
    for (const p of pages.filter((p) => !expectedPages.includes(p))) {
      problems.push(
        `orphan content/flows/${p}.mdx (no such subflow in flows_data.dart)`
      );
    }
    if (problems.length) {
      console.error(
        `Flows drift (${problems.length}):\n  - ${problems.join("\n  - ")}\nRun: bun scripts/flows-manifest.mts`
      );
      process.exit(1);
    }
    console.log(
      `Flows in sync: ${manifest.totals.categories} categories, ${manifest.totals.subflows} subflows.`
    );
    return;
  }

  // Skip unchanged files: this runs before every dev and build, and the
  // committed JSON may be formatted differently.
  const written: string[] = [];
  mkdirSync(path.dirname(MANIFEST), { recursive: true });
  if (!jsonMatches(MANIFEST, manifest)) {
    writeFileSync(MANIFEST, json(manifest));
    written.push(MANIFEST);
  }
  mkdirSync(CONTENT, { recursive: true });
  if (!jsonMatches(META, meta)) {
    writeFileSync(META, json(meta));
    written.push(META);
  }
  const redirects = redirectsWithCategories(manifest);
  if (redirects.current !== redirects.next) {
    writeFileSync(REDIRECTS, redirects.next);
  }
  let created = 0;
  for (const category of manifest.categories) {
    mkdirSync(path.join(CONTENT, category.slug), { recursive: true });
    for (const sub of category.subflows) {
      const file = path.join(CONTENT, category.slug, `${sub.slug}.mdx`);
      if (!existsSync(file)) {
        writeFileSync(file, mdxStub(category, sub));
        written.push(file);
        created++;
      }
    }
  }
  formatWritten(written);
  const orphans = existingMdx().filter((p) => !expectedPages.includes(p));
  console.log(
    `Wrote manifest (${manifest.totals.categories} categories, ${manifest.totals.subflows} subflows), meta.json, category redirects, ${created} new MDX stub(s).${
      orphans.length ? ` Orphan MDX (not deleted): ${orphans.join(", ")}` : ""
    }`
  );
}

if (import.meta.main) {
  main();
}
