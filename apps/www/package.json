{
  "name": "@wirefront/www",
  "version": "1.0.27",
  "private": true,
  "scripts": {
    "analyze": "next experimental-analyze",
    "prebuild": "bun ./scripts/screens-manifest.mts && bun ../../scripts/screen-docs.ts && bun ./scripts/docs-registry.mts && bun ./scripts/fetch-avatar.mts",
    "build": "next build",
    "postbuild": "bun ./scripts/copy-runtime.mts",
    "check-types": "bun ./scripts/screens-manifest.mts && bun ../../scripts/screen-docs.ts && bun ./scripts/docs-registry.mts && tsc --noEmit",
    "typecheck": "bun run check-types",
    "predev": "bun ./scripts/screens-manifest.mts && bun ../../scripts/screen-docs.ts && bun ./scripts/docs-registry.mts",
    "dev": "next dev -p 3000",
    "preview": "WRANGLER_SEND_METRICS=false bunx wrangler@4 pages dev out --port 3000 --ip 127.0.0.1",
    "postinstall": "fumadocs-mdx",
    "screens:manifest": "bun ./scripts/screens-manifest.mts",
    "screens:check": "bun ./scripts/screens-manifest.mts --check",
    "screens:docs": "bun ../../scripts/screen-docs.ts",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "format:write": "ultracite fix",
    "format:check": "ultracite check",
    "audit:motion": "bunx motionscore http://localhost:3000 --no-upload"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@floating-ui/react": "^0.27.20",
    "@wirefront/bridge": "workspace:*",
    "@wirefront/ui": "workspace:*",
    "@workspace/ui": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dialkit": "^2.2.0",
    "fumadocs-core": "15.6.3",
    "fumadocs-mdx": "14.2.14",
    "fumadocs-ui": "15.6.3",
    "gsap": "^3.15.1",
    "hast-util-to-jsx-runtime": "^2.3.7",
    "lenis": "^1.3.27",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.3",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@next/bundle-analyzer": "16.4.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "^4.3.5",
    "@types/bun": "^1.4.5",
    "@types/hast": "^3.0.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wirefront/runtime": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "babel-plugin-react-compiler": "^1.0.0",
    "postcss": "^8.5.33",
    "shadcn": "^4.23.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  }
}
