# Cloudflare Pages response headers (static export has no `headers()`).
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Link: </llms.txt>; rel="describedby"; type="text/plain", </sitemap.xml>; rel="sitemap"; type="application/xml"

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Extensionless build outputs: give them their real content types.
/llms.mdx/*
  Content-Type: text/markdown; charset=utf-8

/llms-screens.mdx/*
  Content-Type: text/markdown; charset=utf-8

/api/*
  Content-Type: application/json; charset=utf-8
