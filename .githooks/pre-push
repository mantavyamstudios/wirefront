#!/bin/sh
# SPDX-License-Identifier: MIT
# Wirefront © 2026 Mantavyam Studios — https://github.com/mantavyamstudios/wirefront
#
# Runs before every `git push`. A failing check stops the push.
# Installed by `bun install` (the root `prepare` script sets core.hooksPath).
set -e

echo "▸ pre-push: typecheck"
bun run --silent typecheck

echo "▸ pre-push: licence headers"
bun run --silent spdx:check

echo "▸ pre-push: lint (no new problems)"
bun run --silent lint:gate

echo "▸ pre-push: tests"
bun run --silent test

echo "✓ pre-push checks passed"
